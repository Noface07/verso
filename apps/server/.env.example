# Domain & Dynamic DNS
DOMAIN=ffxasce.duckdns.org
DUCKDNS_SUBDOMAINS=ffxasce
DUCKDNS_TOKEN=your-duckdns-token-here

# Security
DB_PASSWORD=change-me          # openssl rand -hex 24
JWT_SECRET=change-me           # openssl rand -hex 48
ALLOW_SIGNUP=true              # set to false after creating your initial accounts
CORS_ORIGINS=*
MAX_FILE_MB=300

# Database Connection
# Local dev against the Docker db: postgres://reader:<DB_PASSWORD>@localhost:5432/reader
# (docker-compose.yml ignores this and connects to the bundled `db` service.)
# Supabase: use the *Session pooler* URI from Dashboard → Connect (port 5432, not 6543),
# then run with docker-compose.supabase.yml — see docs/OPERATIONS.md "Using Supabase".
#   DATABASE_URL=postgres://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=postgres://reader:change-me@localhost:5432/reader
# SSL is automatic for Supabase hosts. Optional overrides:
# DATABASE_SSL=require            # disable | require | verify-full
# DATABASE_CA_CERT=./prod-ca-2021.crt   # Supabase CA (Settings → Database → SSL) for full verification
# DATABASE_POOL_MAX=10            # keep below your plan's pooler limit minus 1
# BACKUP_DATABASE_URL=            # set when the DB is hosted, so backups pg_dump over the network

# Cloudflare R2 / S3 Object Storage (Zero egress fees, 10 GB free)
# When configured, uploaded book files are stored permanently in R2 instead of local disk.
# R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com  (or set R2_ACCOUNT_ID)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=verso-books

# Off-site Backup (Restic / S3 / Backblaze B2)
RESTIC_REPOSITORY=s3:s3.us-west-004.backblazeb2.com/your-verso-backup-bucket
RESTIC_PASSWORD=change-me
AWS_ACCESS_KEY_ID=your-key-id
AWS_SECRET_ACCESS_KEY=your-secret-key

# Book file storage (any S3-compatible service). Leave all four unset to store
# files on the server's own disk (FILES_DIR) - on Render that disk is wiped on
# every deploy, so set these there.
# Self-hosted on your PC with s3rver + ngrok (start-storage.bat):
#   R2_ENDPOINT=https://<your-ngrok-domain>.ngrok-free.dev
#   R2_ACCESS_KEY_ID=S3RVER
#   R2_SECRET_ACCESS_KEY=S3RVER
#   R2_BUCKET_NAME=verso-books
# Check it from anywhere: GET https://<server>/health/storage -> {"ok":true}

