{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Verso",
  "version": "0.1.0",
  "identifier": "com.verso.reader",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Verso",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' asset:; frame-src 'self' blob: asset: data:; child-src 'self' blob:; img-src 'self' asset: https: http: data: blob:; script-src 'self' 'unsafe-eval' 'unsafe-inline'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline' blob:; font-src 'self' data: blob:; connect-src 'self' https: http: ws: wss: blob: data:; media-src 'self' asset: blob: data:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "fileAssociations": [
      {
        "ext": [
          "epub",
          "mobi",
          "azw3",
          "azw",
          "fb2",
          "fbz",
          "cbz",
          "cbr",
          "cb7",
          "pdf"
        ],
        "name": "eBook or Comic",
        "description": "eBook or Comic file",
        "role": "Viewer"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
